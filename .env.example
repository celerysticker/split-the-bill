# Neon (or Vercel Postgres): DATABASE_URL is the pooled connection string
# (used by the app at runtime); DIRECT_URL is the unpooled one (used by
# Prisma Migrate — migrations fail against the pooled connection).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
